# Copy to .env and fill in your own values. Never commit .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only:
# DATABASE_URL=postgres://user:pass@host:5432/bloomify
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
# SENTRY_DSN=

# Razorpay (use TEST keys for the demo)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_SECRET_KEY=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# Email (Gmail SMTP with an App Password). Leave blank to print emails to the console.
BLOOMIFY_EMAIL=
BLOOMIFY_EMAIL_PASS=

# Optional S3-compatible storage for uploaded images (AWS S3, Cloudflare R2, ...)
# AWS_STORAGE_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=
